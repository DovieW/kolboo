{
  "rust-analyzer.linkedProjects": ["app/src-tauri/Cargo.toml"],
  "rust-analyzer.server.path": "${env:USERPROFILE}\\.cargo\\bin\\rust-analyzer.exe",
  "rust-analyzer.cargo.targetDir": "app/src-tauri/target-rust-analyzer",
  "rust-analyzer.cargo.autoreload": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.cachePriming.enable": false,
  "rust-analyzer.files.exclude": [
    "app/src-tauri/target-rust-analyzer",
    "app/src-tauri/target",
    "app/src-tauri/target-ci",
    "app/src-tauri/target-cli"
  ],
  "files.watcherExclude": {
    "**/app/src-tauri/target-rust-analyzer/**": true,
    "**/app/src-tauri/target/**": true,
    "**/app/src-tauri/target-ci/**": true,
    "**/app/src-tauri/target-cli/**": true
  },
  "rust-analyzer.check.extraArgs": [
    "--target-dir",
    "app/src-tauri/target-rust-analyzer"
  ],
  "chat.promptFilesRecommendations": {
    "speckit.constitution": true,
    "speckit.specify": true,
    "speckit.plan": true,
    "speckit.tasks": true,
    "speckit.implement": true
  },
  "chat.tools.terminal.autoApprove": {
    ".specify/scripts/bash/": true,
    ".specify/scripts/powershell/": true
  }
}
