    {
      "label": "app: test",
      "type": "shell",
      "command": "pnpm",
      "args": ["-C", "app", "test"],
      "problemMatcher": []
    },
    {
      "label": "app: coverage",
      "type": "shell",
      "command": "pnpm",
      "args": ["-C", "app", "coverage"],
      "problemMatcher": []
