{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**/*", "!!**/coverage"]
	},
	"overrides": [
		{
			"includes": ["src/lib/tauri/types.generated.ts"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/tauri/events.generated.ts"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": [
				"src/overlay/**",
				"src/OverlayApp.tsx",
				"src/OverlayHoverApp.tsx",
				"src/QuickAskApp.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/components/**"],
										"message": "Overlay windows should not import from components/. Use shared lib/ modules instead."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"noFloatingPromises": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "error",
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"a11y": {
				"noStaticElementInteractions": "warn",
				"noNoninteractiveTabindex": "warn",
				"useAriaPropsSupportedByRole": "warn",
				"useMediaCaption": "warn",
				"useSemanticElements": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"complexity": {
				"noImportantStyles": "warn",
				"noUselessFragments": "warn",
				"useIndexOf": "warn",
				"useOptionalChain": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useExponentiationOperator": "warn",
				"useImportType": "warn",
				"useTemplate": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
