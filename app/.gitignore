# Logs
# Ignore only the top-level runtime log folder. A bare `logs` pattern also
# swallows source directories like `src/lib/logs` and `src/components/logs`,
# which makes those modules vanish from Git and then from CI.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
out
release
*.local
*.asar

# Environment variables
.env
.env.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
src-tauri/target*
src-tauri/gen/
src-tauri/Cargo.lock
