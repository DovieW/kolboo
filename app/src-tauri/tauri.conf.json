{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Kolboo",
	"identifier": "com.kolboo.app",
	"mainBinaryName": "kolboo",
	"version": "0.2.4",
	"build": {
		"beforeDevCommand": "pnpm dev:vite",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build:vite",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Kolboo",
				"label": "main",
				"visible": false,
				"width": 1280,
				"height": 720,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: https: data: blob:; media-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
			"devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' asset: https: data: blob:; media-src 'self' asset: data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 https://api.github.com; form-action 'self'; frame-ancestors 'none';"
		}
	},
	"plugins": {
		"cli": {
			"description": "Kolboo CLI",
			"subcommands": {
				"pipeline": {
					"description": "Pipeline operations",
					"subcommands": {
						"run": {
							"description": "Start a headless pipeline run",
							"args": [
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								},
								{
									"name": "profile",
									"short": "p",
									"description": "Profile id to run with",
									"takesValue": true
								}
							]
						},
						"stop": {
							"description": "Stop recording and transcribe",
							"args": [
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						},
						"transcribe": {
							"description": "Transcribe a WAV file",
							"args": [
								{
									"name": "file",
									"short": "f",
									"description": "Path to WAV file",
									"takesValue": true
								},
								{
									"name": "profile",
									"short": "p",
									"description": "Profile id override",
									"takesValue": true
								},
								{
									"name": "stt_provider",
									"description": "Force STT provider for this run (per-run override)",
									"takesValue": true
								},
								{
									"name": "stt_model",
									"description": "Force STT model for this run (per-run override)",
									"takesValue": true
								},
								{
									"name": "llm_provider",
									"description": "Force LLM provider for rewrite (per-run override)",
									"takesValue": true
								},
								{
									"name": "llm_model",
									"description": "Force LLM model for rewrite (per-run override)",
									"takesValue": true
								},
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								},
								{
									"name": "repeat",
									"short": "r",
									"description": "Repeat transcription N times (benchmark)",
									"takesValue": true
								},
								{
									"name": "warmup",
									"short": "w",
									"description": "Warmup runs before measuring (benchmark)",
									"takesValue": true
								}
							]
						},
						"stream": {
							"description": "Stream a WAV file through a streaming STT provider (for testing live output)",
							"args": [
								{
									"name": "file",
									"short": "f",
									"description": "Path to WAV file",
									"takesValue": true
								},
								{
									"name": "stt_provider",
									"description": "STT provider to use (e.g. speechmatics, fireworks, openai, elevenlabs, assemblyai)",
									"takesValue": true
								},
								{
									"name": "stt_model",
									"description": "STT model to use (optional, uses provider default if not specified)",
									"takesValue": true
								},
								{
									"name": "language",
									"short": "l",
									"description": "Language code (e.g. en, es, de) for the STT provider",
									"takesValue": true
								},
								{
									"name": "speed",
									"short": "s",
									"description": "Playback speed multiplier (default: 1.0, use 0 for as-fast-as-possible)",
									"takesValue": true
								},
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						},
						"status": {
							"description": "Get current pipeline status",
							"args": [
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						}
					}
				},
				"settings": {
					"description": "Settings operations",
					"subcommands": {
						"get": {
							"description": "Get a setting value",
							"args": [
								{
									"name": "key",
									"short": "k",
									"description": "Setting key",
									"takesValue": true
								},
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						},
						"set": {
							"description": "Set a setting value",
							"args": [
								{
									"name": "key",
									"short": "k",
									"description": "Setting key",
									"takesValue": true
								},
								{
									"name": "value",
									"short": "v",
									"description": "Setting value (string or JSON)",
									"takesValue": true
								},
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						}
					}
				},
				"profiles": {
					"description": "Profile operations",
					"subcommands": {
						"list": {
							"description": "List available profiles",
							"args": [
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						},
						"use": {
							"description": "Select an active profile",
							"args": [
								{
									"name": "profile",
									"short": "p",
									"description": "Profile id",
									"takesValue": true
								},
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						}
					}
				},
				"diagnostics": {
					"description": "Run diagnostics",
					"args": [
						{
							"name": "output",
							"short": "o",
							"description": "Output format (json|human)",
							"takesValue": true
						}
					]
				},
				"config": {
					"description": "Configuration commands",
					"subcommands": {
						"export": {
							"description": "Export effective configuration",
							"args": [
								{
									"name": "output",
									"short": "o",
									"description": "Output format (json|human)",
									"takesValue": true
								}
							]
						}
					}
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"shortDescription": "Customizable AI-powered voice dictation tool",
		"longDescription": "Open-source alternative to Wispr Flow and SuperWhisper. Speak and your words are typed wherever your cursor is.",
		"license": "AGPL-3.0",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
