{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capabilities for Kolboo",
	"windows": [
		"main",
		"overlay",
		"overlay_hover",
		"quick_ask"
	],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-always-on-top",
		"core:window:allow-start-dragging",
		"dialog:default",
		"opener:default",
		"global-shortcut:default",
		"store:default"
	]
}
