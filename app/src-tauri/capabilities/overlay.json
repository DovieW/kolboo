{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "overlay",
	"description": "Minimal capabilities for overlay windows",
	"windows": ["overlay", "overlay_hover"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-always-on-top",
		"core:window:allow-start-dragging",
		"store:default"
	]
}
