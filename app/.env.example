# -----------------------------------------------------------------------------
# Canonical runtime config (single namespace)
# -----------------------------------------------------------------------------
# Backend reads these vars directly. Frontend windows fetch the runtime subset at
# runtime via `get_runtime_config` from the backend; keep dev-only secrets local.

# General app version metadata (used by PostHog and as a Sentry fallback).
TAURI_APP_VERSION=0.0.0

# Cloud endpoint used by backend runtime (sync/settings API).
# Use a real deployed api-edge Worker origin, for example:
# https://kolboo.dovie.dev
TAURI_API_BASE_URL=

# Managed inference gateway URL.
# Usually the same deployed api-edge Worker origin as TAURI_API_BASE_URL.
TAURI_MANAGED_INFERENCE_GATEWAY_URL=

# Optional Cloudflare Access Service Auth token for hosted-dev Workers.
# Set both values locally when the dev api-edge Worker is Access-gated.
# Release builds refuse to start if these dev-only vars are present.
TAURI_CLOUDFLARE_ACCESS_CLIENT_ID=
TAURI_CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Release builds fail if the cloud endpoint vars above are missing or placeholder.
# Only set this for an intentional offline/internal release build.
KOLBOO_ALLOW_MISSING_RELEASE_CLOUD_ENDPOINTS=0

# Sentry for backend runtime.
TAURI_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
TAURI_SENTRY_ENV=production
TAURI_SENTRY_RELEASE=kolboo@0.0.0
# Optional packaged-app smoke trigger for Windows/manual rehearsal. Keep this
# empty or `0` for normal launches; set to `1` only when intentionally proving a
# non-production packaged build can emit the frontend smoke event.
TAURI_SENTRY_SMOKE=0

# Optional browser-only Sentry overrides for `pnpm dev:vite` smoke verification.
# The real desktop app still prefers the TAURI_* runtime values above whenever
# the backend bridge is available.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=preview
VITE_SENTRY_RELEASE=kolboo@preview-local

# Optional build-time Sentry source-map upload.
# The Vite build derives the public dev/prod project from TAURI_SENTRY_ENV
# unless SENTRY_PROJECT explicitly overrides it.
# Use an org token with Project: Read & Write plus Release: Admin scopes.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=dov-weinstock
SENTRY_PROJECT=
SENTRY_RELEASE=

# PostHog product analytics (event-only, privacy-safe).
# Enabled by default in-app when PostHog is configured.
TAURI_POSTHOG_API_KEY=phc_xxx
# US default host. For EU use: https://eu.i.posthog.com
TAURI_POSTHOG_HOST=https://us.i.posthog.com

# Supabase auth values used by backend runtime for real desktop sign-in.
TAURI_SUPABASE_URL=https://your-project-ref.supabase.co
TAURI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional hosted Kolboo auth page for browser sign-in/sign-up/magic-link.
# When set, desktop browser auth prefers this page and hands the session back
# through the existing loopback callback. Example local dev value:
# http://localhost:5173/login
TAURI_PUBLIC_AUTH_PAGE_URL=

# Supabase OAuth provider used for browser sign-in, for example: google.
# This remains the direct-provider fallback when TAURI_PUBLIC_AUTH_PAGE_URL is
# unset or when a caller explicitly requests provider OAuth.
TAURI_AUTH_PROVIDER=google
