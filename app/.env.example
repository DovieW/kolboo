# Optional cloud sync endpoint for desktop runtime.
# `KOLBOO_SYNC_BASE_URL` takes precedence when both are set.
KOLBOO_SYNC_BASE_URL=https://api.kolboo.example
VITE_SYNC_BASE_URL=https://api.kolboo.example

# Optional managed inference gateway base URL (usually same api-edge Worker base URL).
VITE_MANAGED_INFERENCE_GATEWAY_URL=https://api.kolboo.example

# Required for real desktop account sign-in via Supabase Auth.
# `KOLBOO_SUPABASE_*` takes precedence when both are set.
KOLBOO_SUPABASE_URL=https://your-project-ref.supabase.co
KOLBOO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
