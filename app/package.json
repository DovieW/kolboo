{
	"name": "kolboo",
	"version": "0.2.3",
	"description": "Customizable AI-powered voice dictation",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.26.2",
	"scripts": {
		"prepare": "cd .. && husky app/.husky",
		"dev": "tauri dev",
		"dev:sccache": "node scripts/dev-sccache.mjs",
		"dev:local-whisper": "tauri dev --features local-whisper",
		"dev:local-whisper:cuda": "tauri dev --features local-whisper-cuda",
		"dev:vite": "vite",
		"build": "tauri build",
		"build:local-whisper": "tauri build --features local-whisper",
		"build:local-whisper:cuda": "tauri build --features local-whisper-cuda",
		"build:vite": "vite build",
		"lint": "biome check --write",
		"lint:ci": "biome lint .",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run --reporter=dot",
		"coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"schemas:generate": "node scripts/generate-schemas.mjs",
		"schemas:check": "pnpm run schemas:generate && git diff --exit-code -- src-tauri/gen/schemas",
		"test:all": "pnpm run typecheck && pnpm test && pnpm run cargo:test",
		"cargo:clippy": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml",
		"cargo:clippy:ci": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target-ci",
		"cargo:clippy:local-whisper": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml --features local-whisper",
		"cargo:clippy:local-whisper:ci": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml --features local-whisper --target-dir src-tauri/target-ci",
		"cargo:clippy:all-features": "cargo clippy --all-targets --all-features --manifest-path src-tauri/Cargo.toml",
		"cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"cargo:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
		"cargo:test": "cargo test --quiet --manifest-path src-tauri/Cargo.toml",
		"cargo:test:ci": "cargo test --quiet --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target-ci",
		"cargo": "pnpm run cargo:clippy && pnpm run cargo:fmt && pnpm run cargo:test",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm test && pnpm run cargo",
		"check:ci": "pnpm run lint:ci && pnpm run typecheck && pnpm run knip && pnpm run schemas:check && pnpm test && pnpm run cargo:clippy:ci && pnpm run cargo:fmt:check && pnpm run cargo:test:ci",
		"check:ci:local-whisper": "pnpm run check:ci && pnpm run cargo:clippy:local-whisper:ci",
		"tauri": "tauri"
	},
	"author": "kstonekuan",
	"license": "AGPL-3.0",
	"dependencies": {
		"@fontsource/outfit": "^5.2.8",
		"@fontsource/sora": "^5.2.8",
		"@mantine/code-highlight": "^8.3.11",
		"@mantine/core": "^8.3.11",
		"@mantine/hooks": "^8.3.11",
		"@mantine/notifications": "^8.3.11",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.90.16",
		"@tauri-apps/api": "^2.9.1",
		"@tauri-apps/plugin-dialog": "^2.5.0",
		"@tauri-apps/plugin-opener": "^2.5.3",
		"@tauri-apps/plugin-store": "^2.4.2",
		"@use-gesture/react": "^10.3.1",
		"date-fns": "^4.1.0",
		"highlight.js": "^11.11.1",
		"lucide-react": "^0.562.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-hotkeys-hook": "^5.2.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@tauri-apps/cli": "^2.9.6",
		"@vitest/coverage-v8": "^4.0.16",
		"husky": "^9.1.7",
		"@types/node": "^25.0.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.2",
		"knip": "^5.80.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-svgr": "^4.5.0",
		"vitest": "^4.0.16"
	}
}
