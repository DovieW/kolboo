{
	"name": "kolboo",
	"version": "0.2.3",
	"description": "Customizable AI-powered voice dictation",
	"packageManager": "pnpm@10.26.2",
	"scripts": {
		"dev": "tauri dev",
		"dev:vite": "vite",
		"build": "tauri build",
		"build:vite": "vite build",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run --reporter=dot",
		"test:watch": "vitest",
		"cargo:clippy": "cargo clippy --all-targets --all-features --manifest-path src-tauri/Cargo.toml",
		"cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"cargo:test": "cargo test --quiet --manifest-path src-tauri/Cargo.toml",
		"cargo": "pnpm run cargo:clippy && pnpm run cargo:fmt && pnpm run cargo:test",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm test && pnpm run cargo",
		"tauri": "tauri"
	},
	"author": "kstonekuan",
	"license": "AGPL-3.0",
	"dependencies": {
		"@fontsource/outfit": "^5.2.8",
		"@fontsource/sora": "^5.2.8",
		"@mantine/code-highlight": "^8.3.10",
		"@mantine/core": "^8.3.10",
		"@mantine/hooks": "^8.3.10",
		"@mantine/notifications": "^8.3.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.90.15",
		"@tauri-apps/api": "^2.9.1",
		"@tauri-apps/plugin-dialog": "^2.4.1",
		"@tauri-apps/plugin-store": "^2.4.1",
		"@use-gesture/react": "^10.3.1",
		"date-fns": "^4.1.0",
		"highlight.js": "^11.11.1",
		"lucide-react": "^0.562.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-hotkeys-hook": "^5.2.1",
		"tailwindcss": "^4.1.18",
		"zod": "^4.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@tauri-apps/cli": "^2.9.6",
		"@types/node": "^25.0.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.2",
		"knip": "^5.73.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-plugin-svgr": "^4.5.0",
		"vitest": "^4.0.16"
	}
}
