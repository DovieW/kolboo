# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
# Ignore only a real repo-root logs folder. A bare `logs/` pattern also hides
# source directories like `app/src/lib/logs` and `app/src/components/logs`,
# which then disappear from Git and break CI/typecheck on clean clones.
/logs/

# Temporary/profiling artifacts
*.tmp
*.rs.bk
*.rlib
*.prof*

# Local debugging artifacts
cdb-*.txt

.ralph/**/state/
.ralph/**/state/**
.ralph/**/done-tickets.txt

# Generated release notes (local)
RELEASE_NOTES.md

# Testing
.pytest_cache/
.coverage
htmlcov/

# Vitest coverage output
app/coverage/

# Vitest cache (when enabled)
app/.vitest/

# Type checking
.mypy_cache/
.pytype/
